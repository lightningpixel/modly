{
  "id": "mesh-optimizer",
  "name": "Mesh Optimizer",
  "type": "process",
  "entry": "processor.js",
  "version": "1.0.0",
  "author": "Modly",
  "description": "Reduces mesh triangle count using quadric simplification (meshoptimizer).",
  "nodes": [
    {
      "id": "optimize",
      "name": "Optimize Mesh",
      "input": "mesh",
      "output": "mesh",
      "params_schema": [
        {
          "id": "target_faces",
          "label": "Detail",
          "type": "select",
          "default": 1000000,
          "options": [
            { "value": 1000000, "label": "Full detail (unchanged)" },
            { "value": 12000, "label": "Light — background props" },
            { "value": 30000, "label": "Standard — most props" },
            { "value": 60000, "label": "Heavy — hero pieces you get close to" },
            { "value": 120000, "label": "Very heavy — 3D printing, film shots" }
          ]
        }
      ]
    }
  ]
}
